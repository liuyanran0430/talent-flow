# 复制为 .env 并按实际 MySQL 配置填写
APP_NAME=TalentFlow Backend
APP_ENV=dev
APP_DEBUG=true

# MySQL 连接配置（与前端 talent-flow 对接的招聘后台库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=talent_flow

# 前端地址（用于 CORS，多个用逗号分隔）
FRONTEND_ORIGIN=http://localhost:3001

# LLM（OpenAI 兼容）配置
LLM_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_API_BASE=
# 单次请求硬超时（秒）
LLM_TIMEOUT=120
# 单次输出 token 上限（配合输入截断，防止超出模型上下文窗口）
LLM_MAX_TOKENS=4000
# 可重试错误（429 限流/超时/连接中断/5xx）重试次数与等待秒数：指数退避 1s/2s/4s
LLM_MAX_RETRIES=3
LLM_RETRY_INITIAL_WAIT=1.0
LLM_RETRY_MAX_WAIT=10.0
# 退避随机抖动（秒）：0 = 严格 1s/2s/4s；并发量大时可调大避免惊群
LLM_RETRY_JITTER=0.0

# ---------- RAG / 岗位标准知识库 ----------
# 关闭后检索直接返回空，回退到纯 LLM 生成（不影响主流程）
RAG_ENABLED=true
# 每次注入 Prompt 的标准条数上限与相似度阈值
RAG_TOP_K=5
RAG_MIN_SCORE=0.60
# DashScope 向量模型（OpenAI 兼容接口）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
# 向量库实现：chroma 本地持久化 / null 空实现（降级）
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_PATH=data/vector_store
# 重建索引时每批向量化条数
RAG_REBUILD_BATCH=32
# 混合检索：BM25 关键词支路（关闭后仅走向量检索）
RAG_BM25_ENABLED=true
# RRF 融合常数，越大排名差异权重越平滑
RAG_RRF_K=60
# 融合前每路召回数量
RAG_CANDIDATE_POOL=15
# 规则 rerank 中名称/别名精确命中的加权上限
RAG_NAME_MATCH_BOOST=0.2
