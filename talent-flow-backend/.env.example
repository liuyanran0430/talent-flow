# 复制为 .env 并按实际 MySQL 配置填写
APP_NAME=TalentFlow Backend
APP_ENV=dev
APP_DEBUG=true

# MySQL 连接配置（与前端 talent-flow 对接的招聘后台库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=talent_flow

# 前端地址（用于 CORS）
FRONTEND_ORIGIN=http://localhost:3000

# LLM（OpenAI 兼容）配置
LLM_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_API_BASE=
LLM_TIMEOUT=120
# 可重试错误（超时/连接中断/429/5xx）重试次数与等待秒数
LLM_MAX_RETRIES=2
LLM_RETRY_INITIAL_WAIT=1.0
LLM_RETRY_MAX_WAIT=10.0
